{
  "name": "campus-opinion-board",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "preview": "npm run build && wrangler dev --config dist/server/wrangler.json",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply campus-opinion-board-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply campus-opinion-board-db --remote"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@cloudflare/workers-types": "5.20260915.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.131.2"
  }
}
